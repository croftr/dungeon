# Asset base URL for external CDN (S3 + CloudFront)
# Leave empty for local dev (Vite serves from public/)
# Set to your CloudFront URL for production, e.g.:
#   VITE_ASSET_BASE=https://d1234abcdef.cloudfront.net
VITE_ASSET_BASE=

# S3 bucket CORS config (apply via AWS Console or CLI):
